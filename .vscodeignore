.DS_Store
tsconfig.json
esbuild.js
eslint.config.mjs
AGENTS.md
CONTRIBUTING.md

# Source maps (large, not needed at runtime)
dist/**/*.map

# Repository-only content
.claude/**
docs/**
releases/**
