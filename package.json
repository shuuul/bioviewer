{
  "name": "bioviewer",
  "displayName": "BioViewer",
  "publisher": "shuuul",
  "description": "VSCode Extension for visualizing Biological Macrostructures and Electron Imaging.",
  "version": "0.2.1",
  "icon": "dist/resources/img/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/shuuul/bioviewer.git"
  },
  "bugs": {
    "url": "https://github.com/shuuul/bioviewer/issues"
  },
  "homepage": "https://github.com/shuuul/bioviewer#readme",
  "author": {
    "name": "shuuul",
    "url": "https://github.com/shuuul"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.105.1",
    "node": ">=18.0.0"
  },
  "categories": [
    "Other",
    "Visualization",
    "Data Science"
  ],
  "keywords": [
    "biology",
    "molecular",
    "structure",
    "visualization",
    "pdb",
    "sdf",
    "ligand",
    "small molecule",
    "electron microscopy",
    "cryo-em"
  ],
  "activationEvents": [
    "onCommand:bioviewer.openFromDatabase",
    "onCommand:bioviewer.openFiles",
    "onCommand:bioviewer.openFolder",
    "onCommand:bioviewer.addFiles",
    "onCommand:bioviewer.addFolder"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "bioviewer.openFromDatabase",
        "title": "BioViewer: Open Structure from Database"
      },
      {
        "command": "bioviewer.openFiles",
        "title": "BioViewer: Open Files"
      },
      {
        "command": "bioviewer.openFolder",
        "title": "BioViewer: Open Folder"
      },
      {
        "command": "bioviewer.addFiles",
        "title": "BioViewer: Add Files to Current Tab"
      },
      {
        "command": "bioviewer.addFolder",
        "title": "BioViewer: Add Folder to Current Tab"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "when": "resourcePath =~ /\\.(pdb|cif|mmcif|mcif|ent|map|mrc|ccp4|sdf|sd|mol|mol2|pdbqt)(\\.gz)?$/i",
          "command": "bioviewer.openFiles",
          "group": "navigation"
        },
        {
          "when": "explorerResourceIsFolder",
          "command": "bioviewer.openFolder",
          "group": "navigation"
        },
        {
          "when": "resourcePath =~ /\\.(pdb|cif|mmcif|mcif|ent|map|mrc|ccp4|sdf|sd|mol|mol2|pdbqt)(\\.gz)?$/i",
          "command": "bioviewer.addFiles",
          "group": "navigation"
        },
        {
          "when": "explorerResourceIsFolder",
          "command": "bioviewer.addFolder",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "version": "commit-and-tag-version",
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "rm -rf out && tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test",
    "prepare": "npm run compile",
    "clean": "rm -rf dist out releases/*.vsix",
    "build:vsix": "npm run clean && npm run compile && mkdir -p releases && vsce package --out releases/bioviewer.vsix",
    "test:vsix": "npm run build:vsix && code --install-extension releases/bioviewer.vsix"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.19.37",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/vscode": "1.105.0",
    "@typescript-eslint/eslint-plugin": "^8.57.1",
    "@typescript-eslint/parser": "^8.57.1",
    "@vscode/test-cli": "0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.7.1",
    "commit-and-tag-version": "^12.7.1",
    "esbuild": "^0.27.4",
    "eslint": "^10.0.3",
    "npm-run-all2": "^8.0.4",
    "ovsx": "^0.10.9",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "molstar": "^5.7.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "galleryBanner": {
    "color": "#C80000",
    "theme": "dark"
  },
  "badges": [
    {
      "url": "https://img.shields.io/visual-studio-marketplace/v/shuuul.bioviewer",
      "href": "https://marketplace.visualstudio.com/items?itemName=shuuul.bioviewer",
      "description": "VS Marketplace Version"
    },
    {
      "url": "https://img.shields.io/visual-studio-marketplace/i/shuuul.bioviewer",
      "href": "https://marketplace.visualstudio.com/items?itemName=shuuul.bioviewer",
      "description": "VS Marketplace Installs"
    }
  ]
}
