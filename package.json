{
  "name": "bioviewer",
  "displayName": "BioViewer",
  "publisher": "shuuul",
  "description": "VSCode Extension for visualizing Biological Macrostructures and Electron Imaging.",
  "version": "0.3.6",
  "icon": "dist/resources/img/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/shuuul/bioviewer.git"
  },
  "bugs": {
    "url": "https://github.com/shuuul/bioviewer/issues"
  },
  "homepage": "https://github.com/shuuul/bioviewer#readme",
  "author": {
    "name": "shuuul",
    "url": "https://github.com/shuuul"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.128.0",
    "node": ">=22.22.2"
  },
  "categories": [
    "Other",
    "Visualization",
    "Data Science"
  ],
  "keywords": [
    "biology",
    "molecular",
    "structure",
    "visualization",
    "pdb",
    "sdf",
    "ligand",
    "small molecule",
    "electron microscopy",
    "cryo-em"
  ],
  "activationEvents": [
    "onCommand:bioviewer.openFromDatabase",
    "onCommand:bioviewer.openFiles",
    "onCommand:bioviewer.openFolder",
    "onCommand:bioviewer.addFiles",
    "onCommand:bioviewer.addFolder"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "bioviewer.openFromDatabase",
        "title": "BioViewer: Open Structure from Database"
      },
      {
        "command": "bioviewer.openFiles",
        "title": "BioViewer: Open Files"
      },
      {
        "command": "bioviewer.openFolder",
        "title": "BioViewer: Open Folder"
      },
      {
        "command": "bioviewer.addFiles",
        "title": "BioViewer: Add Files to Current Tab"
      },
      {
        "command": "bioviewer.addFolder",
        "title": "BioViewer: Add Folder to Current Tab"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "when": "resourcePath =~ /\\.(pdb|cif|mmcif|mcif|ent|map|mrc|ccp4|sdf|sd|mol|mol2|pdbqt|cmm)(\\.gz)?$/i",
          "command": "bioviewer.openFiles",
          "group": "navigation"
        },
        {
          "when": "explorerResourceIsFolder",
          "command": "bioviewer.openFolder",
          "group": "navigation"
        },
        {
          "when": "resourcePath =~ /\\.(pdb|cif|mmcif|mcif|ent|map|mrc|ccp4|sdf|sd|mol|mol2|pdbqt|cmm)(\\.gz)?$/i",
          "command": "bioviewer.addFiles",
          "group": "navigation"
        },
        {
          "when": "explorerResourceIsFolder",
          "command": "bioviewer.addFolder",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "version": "commit-and-tag-version",
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "npm run tsc7 -- --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "rm -rf out && npm run tsc7 -- -p . --outDir out",
    "watch-tests": "npm run tsc7 -- -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile",
    "tsc7": "node ./node_modules/typescript-7/bin/tsc",
    "check-types": "npm run tsc7 -- --noEmit",
    "lint": "eslint src",
    "test": "vscode-test",
    "prepare": "npm run compile",
    "clean": "rm -rf dist out releases/*.vsix",
    "build:vsix": "npm run clean && npm run compile && mkdir -p releases && vsce package --out releases/bioviewer.vsix",
    "test:vsix": "npm run build:vsix && code --install-extension releases/bioviewer.vsix"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.10.13",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/vscode": "1.125.0",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.9.2",
    "commit-and-tag-version": "^13.1.2",
    "esbuild": "^0.28.1",
    "eslint": "^10.8.0",
    "npm-run-all2": "^9.0.3",
    "ovsx": "^1.1.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-7": "npm:typescript@^7.0.2"
  },
  "dependencies": {
    "molstar": "^5.11.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "overrides": {
    "brace-expansion": "5.0.9",
    "handlebars": "4.7.9",
    "path-to-regexp": "8.4.0",
    "fast-xml-parser": "5.7.0",
    "fast-uri": "3.1.7",
    "undici": "7.29.0",
    "diff": "8.0.4",
    "serialize-javascript": "7.0.5"
  },
  "galleryBanner": {
    "color": "#C80000",
    "theme": "dark"
  },
  "badges": [
    {
      "url": "https://vsmarketplacebadges.dev/version/shuuul.bioviewer.svg",
      "href": "https://marketplace.visualstudio.com/items?itemName=shuuul.bioviewer",
      "description": "VS Marketplace Version"
    },
    {
      "url": "https://vsmarketplacebadges.dev/installs/shuuul.bioviewer.svg",
      "href": "https://marketplace.visualstudio.com/items?itemName=shuuul.bioviewer",
      "description": "VS Marketplace Installs"
    }
  ],
  "allowScripts": {
    "@vscode/vsce-sign@2.0.9": true,
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": true,
    "keytar@7.9.0": true,
    "@scarf/scarf": false
  }
}
